.venv/

# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/

# Local environment files
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# Local datasets
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Trained model artifacts
models/*
!models/.gitkeep
*.joblib
*.pkl
*.pickle
*.onnx
*.pt
*.pth
*.h5
*.hdf5

# Packet captures
*.pcap
*.pcapng

# Editors and IDEs
.vscode/
.idea/
*.iml

# Operating systems
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
